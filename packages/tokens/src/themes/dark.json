{
    "color": {
        "$type": "color",
        "background": {
            "primary": {
                "$value": "{color.neutral.900}"
            },
            "inverse": {
                "$value": "{color.neutral.50}"
            },
            "secondary": {
                "$value": "{color.neutral.800}"
            },
            "brand": {
                "$value": "{color.primary.500}"
            }
        },
        "text": {
            "primary": {
                "$value": "{color.neutral.50}"
            },
            "secondary": {
                "$value": "{color.neutral.400}"
            },
            "inverse": {
                "$value": "{color.neutral.900}"
            },
            "link": {
                "$value": "{color.primary.300}"
            },
            "disabled": {
                "$value": "{color.neutral.600}"
            }
        },
        "surface": {
            "default": {
