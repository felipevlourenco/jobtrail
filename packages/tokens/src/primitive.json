        "md": {
            "$value": "16px"
        },
        "lg": {
            "$value": "20px"
        },
        "xl": {
            "$value": "24px"
        }
    },
    "shadow": {
        "$type": "shadow",
        "sm": {
            "$value": {
                "color": "#0000000D",
                "offsetX": "0px",
                "offsetY": "1px",
                "blur": "2px",
                "spread": "0px"
            }
        },
        "md": {
            "$value": {
                "color": "#0000001A",
                "offsetX": "0px",
                "offsetY": "4px",
                "blur": "6px",
                "spread": "0px"
            }
        }
    }
