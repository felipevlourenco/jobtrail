            "border": {
                "$value": "{color.success.500}"
            },
            "text": {
                "$value": "{color.success.50}"
            }
        },
        "warning": {
            "background": {
                "$value": "{color.warning.900}"
            },
            "border": {
                "$value": "{color.warning.500}"
            },
            "text": {
                "$value": "{color.warning.50}"
            }
        },
        "danger": {
            "background": {
                "$value": "{color.danger.900}"
            },
            "border": {
                "$value": "{color.danger.500}"
            },
            "text": {
                "$value": "{color.danger.50}"
            }
        }
    },
    "button": {
        "primary": {
            "background": {
                "$type": "color",
