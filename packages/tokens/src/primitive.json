{
    "color": {
        "$type": "color",
        "primary": {
            "50": {
                "$value": "#eff6ff"
            },
            "500": {
                "$value": "#3b82f6"
            },
            "900": {
                "$value": "#1e3a8a"
            }
        },
        "neutral": {
            "50": {
                "$value": "#fafafa"
            },
            "500": {
                "$value": "#737373"
            },
            "900": {
                "$value": "#171717"
            }
        }
    },
    "spacing": {
        "$type": "dimension",
        "xs": { "$value": "4px" },
        "sm": { "$value": "8px" },
        "md": { "$value": "16px" },
        "lg": { "$value": "24px" },
        "xl": { "$value": "32px" }
    },
    "radius": {
        "$type": "dimension",
        "sm": { "$value": "4px" },
        "md": { "$value": "8px" },
        "lg": { "$value": "16px" },
        "full": { "$value": "9999px" }
    },
    "fontSize": {
        "$type": "dimension",
        "xs": { "$value": "12px" },
        "sm": { "$value": "14px" },
        "md": { "$value": "16px" },
        "lg": { "$value": "20px" },
        "xl": { "$value": "24px" }
    },
    "shadow": {
        "$type": "shadow",
        "sm": {
            "$value": {
                "color": "#0000000D",
                "offsetX": "0px",
                "offsetY": "1px",
                "blur": "2px",
                "spread": "0px"
            }
        },
        "md": {
            "$value": {
                "color": "#0000001A",
                "offsetX": "0px",
                "offsetY": "4px",
                "blur": "6px",
                "spread": "0px"
            }
        }
    }
}
